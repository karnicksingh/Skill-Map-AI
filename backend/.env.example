# ── Database ────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<dbname>

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_string

# ── Redis (Upstash / Redis Cloud) ───────────────────────────────
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# ── AI / Email ──────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_genai_key
RESEND_API_KEY=your_resend_api_key

# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ────────────────────────────────────────────────────────
# Frontend origin — EC2 IP or domain (no trailing slash)
CLIENT_URL=http://YOUR_EC2_PUBLIC_IP
